generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tipo {
  RECEITA
  DESPESA
}

model User {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  password String

  categories      Category[]
  formasPagamento FormaPagamento[]
  transactions    Transaction[]
  budgets         Budget[]
}

model Category {
  id     Int    @id @default(autoincrement())
  nome   String
  cor    String
  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_category_userId")

  transactions Transaction[]
  budgets      Budget[]

  @@unique([nome, userId])
  @@unique([id, userId])
}

model FormaPagamento {
  id           Int       @id @default(autoincrement())
  nome         String
  dataValidade DateTime?
  userId       Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_formaPagamento_userId")

  transactions Transaction[]

  @@unique([id, userId])
  @@unique([nome, userId])
}

model Transaction {
  id               Int      @id @default(autoincrement())
  tipo             Tipo
  valor            Decimal  @db.Decimal(12, 2)
  descricao        String
  data             DateTime
  createdAt        DateTime @default(now())
  parcelamentoId   String?
  parcelaAtual     Int?
  totalParcelas    Int?
  categoryId       Int
  userId           Int
  formaPagamentoId Int

  category       Category       @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_categoryId")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_userId")
  formaPagamento FormaPagamento @relation(fields: [formaPagamentoId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_formaPagamentoId")

  @@index([userId, data])
  @@index([formaPagamentoId, userId])
  @@index([categoryId, userId])
  @@index([parcelamentoId])
}

model Budget {
  id          Int      @id @default(autoincrement())
  mes         DateTime @db.Date
  valorLimite Decimal  @db.Decimal(12, 2)
  categoryId  Int
  userId      Int

  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_categoryId")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_userId")

  @@unique([userId, mes, categoryId])
  @@index([categoryId, userId])
}
