generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Tipo {
  RECEITA
  DESPESA
}

model User {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  password String

  // Usuário temporário do modo demonstração (ver src/demo). Apagar o User
  // apaga tudo dele em cascata.
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?

  categories      Category[]
  subcategories   Subcategory[]
  formasPagamento FormaPagamento[]
  transactions    Transaction[]
  budgets         Budget[]

  transacoesRecorrentes TransacaoRecorrente[]

  @@index([isDemo, demoExpiresAt])
}

// Uma linha por demo criado, para limitar criações por IP. Funciona com várias
// instâncias serverless, ao contrário de um contador em memória. Guarda só o
// HMAC do IP, nunca o IP em si.
model DemoRateLimit {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

model Category {
  id              Int     @id @default(autoincrement())
  nome            String
  nomeNormalizado String
  cor             String
  ativo           Boolean @default(true)
  userId          Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_category_userId")

  transactions  Transaction[]
  budgets       Budget[]
  subcategories Subcategory[]

  transacoesRecorrentes TransacaoRecorrente[]

  // Cor única só entre as categorias ativas: arquivar uma categoria libera a
  // cor dela (o front só mostra como ocupadas as cores das ativas).
  @@unique([cor, userId], where: { ativo: true })
  @@unique([userId, nomeNormalizado])
  @@unique([id, userId])
}

model Subcategory {
  id              Int     @id @default(autoincrement())
  nome            String
  nomeNormalizado String
  ativo           Boolean @default(true)
  categoryId      Int
  userId          Int

  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_subcategory_categoryId")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subcategory_userId")

  transactions Transaction[]

  transacoesRecorrentes TransacaoRecorrente[]

  @@unique([userId, categoryId, nomeNormalizado])
  @@unique([id, userId])
  @@index([categoryId, userId])
}

model FormaPagamento {
  id              Int     @id @default(autoincrement())
  nome            String
  nomeNormalizado String
  diaValidade     Int?
  diaFechamento   Int?
  ativo           Boolean @default(true)
  userId          Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_formaPagamento_userId")

  transactions Transaction[]

  transacoesRecorrentes TransacaoRecorrente[]

  @@unique([id, userId])
  @@unique([userId, nomeNormalizado])
}

model Transaction {
  id               Int       @id @default(autoincrement())
  tipo             Tipo
  valor            Decimal   @db.Decimal(12, 2)
  descricao        String
  data             DateTime
  createdAt        DateTime  @default(now())
  parcelamentoId   String?
  parcelaAtual     Int?
  totalParcelas    Int?
  categoryId       Int?
  subcategoryId    Int?
  userId           Int
  formaPagamentoId Int?
  dataVencimento   DateTime? @db.Date
  // Preenchidos só nas transações geradas por uma TransacaoRecorrente.
  recorrenciaId    Int?
  // 1º dia do mês que originou o lançamento. A unicidade usa este campo (e
  // não `data`) para que editar a data de uma transação gerada não a recrie.
  competencia      DateTime? @db.Date

  category       Category?            @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_categoryId")
  subcategory    Subcategory?         @relation(fields: [subcategoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_subcategoryId")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transaction_userId")
  formaPagamento FormaPagamento?      @relation(fields: [formaPagamentoId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_formaPagamentoId")
  recorrencia    TransacaoRecorrente? @relation(fields: [recorrenciaId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_recorrenciaId")

  @@unique([recorrenciaId, competencia])
  @@index([recorrenciaId, userId])
  @@index([userId, data])
  @@index([formaPagamentoId, userId])
  @@index([categoryId, userId])
  @@index([subcategoryId, userId])
  @@index([parcelamentoId])
  @@index([userId, dataVencimento])
}

model Budget {
  id          Int      @id @default(autoincrement())
  mes         DateTime @db.Date
  valorLimite Decimal  @db.Decimal(12, 2)
  categoryId  Int
  userId      Int

  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_categoryId")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_budget_userId")

  @@unique([userId, mes, categoryId])
  @@index([categoryId, userId])
}

// Regra de lançamento mensal (aluguel, assinatura, salário). As transações são
// geradas pela função SQL gerar_transacoes_recorrentes (ver a migration).
model TransacaoRecorrente {
  id                Int       @id @default(autoincrement())
  tipo              Tipo
  valor             Decimal   @db.Decimal(12, 2)
  descricao         String
  diaDoMes          Int
  dataInicio        DateTime  @db.Date
  // null = sem fim
  dataFim           DateTime? @db.Date
  ativo             Boolean   @default(true)
  // Última competência já processada pela função. Ela só gera meses depois
  // desta, então apagar uma transação gerada não faz o job recriá-la.
  ultimaCompetencia DateTime? @db.Date
  categoryId        Int?
  subcategoryId     Int?
  formaPagamentoId  Int?
  userId            Int
  createdAt         DateTime  @default(now())

  category       Category?       @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transacaoRecorrente_categoryId")
  subcategory    Subcategory?    @relation(fields: [subcategoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transacaoRecorrente_subcategoryId")
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_transacaoRecorrente_formaPagamentoId")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transacaoRecorrente_userId")

  transacoes Transaction[]

  @@unique([id, userId])
  @@index([userId, ativo])
}
