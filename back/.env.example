# Conexão usada pelo app. No Neon: a URL com pooler (host com "-pooler").
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5433/BANCO"
# Só em produção (Neon): conexão direta, sem "-pooler", usada pelo prisma migrate.
# DATABASE_URL_UNPOOLED=""

JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Cadastro e login com e-mail/senha. Só "true" no ambiente local.
ALLOW_REGISTRATION="true"

# Origens aceitas pelo CORS (separe várias por vírgula).
FRONT_URL="http://localhost:5173"

# Segredo do Vercel Cron (limpeza diária dos demos). Letras e números, 16+.
CRON_SECRET=""

# Modo demonstração (opcionais; estes são os padrões).
# DEMO_TTL_HORAS=6
# DEMO_MAX_ATIVOS=100
# DEMO_RATE_LIMIT_POR_HORA=5
# DEMO_MAX_TRANSACOES=300
# DEMO_MAX_RECORRENCIAS=10
# DEMO_MAX_CATEGORIAS=20
# DEMO_MAX_SUBCATEGORIAS=40
# DEMO_MAX_FORMAS_PAGAMENTO=5
# DEMO_MAX_ORCAMENTOS=30
